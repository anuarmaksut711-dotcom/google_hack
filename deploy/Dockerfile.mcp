# Build from recovery_app: docker build -f deploy/Dockerfile.mcp -t campuspulse-mcp:t10 .
# T12 must configure private Cloud Run IAM plus the trusted composition factory.
FROM python:3.12.13-slim-bookworm AS build
WORKDIR /build
COPY requirements/dev.lock /locks/dev.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /locks/dev.lock
COPY pyproject.toml ./
COPY requirements/LICENSE requirements/LICENSE
COPY src src
RUN python -m build --no-isolation --wheel --outdir /wheels

FROM python:3.12.13-slim-bookworm
WORKDIR /app
COPY requirements/mcp-linux.lock /locks/mcp-linux.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /locks/mcp-linux.lock
COPY --from=build /wheels /wheels
RUN python -m pip install --no-cache-dir --no-deps /wheels/*.whl && useradd --uid 10001 --create-home app
COPY deploy/mcp-entrypoint.py /app/mcp-entrypoint.py
USER 10001
ENV PORT=8080 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
EXPOSE 8080
CMD ["python", "/app/mcp-entrypoint.py"]
