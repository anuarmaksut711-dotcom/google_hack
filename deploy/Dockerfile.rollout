FROM eclipse-temurin:21-jre-jammy AS java
FROM node:22-bookworm-slim AS node
FROM mcr.microsoft.com/powershell:7.4-debian-12 AS powershell

FROM python:3.12.13-slim-bookworm AS verified
ARG SOURCE_SHA
WORKDIR /build
COPY --from=java /opt/java/openjdk /opt/java/openjdk
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=powershell /opt/microsoft/powershell/7 /opt/microsoft/powershell/7
ENV JAVA_HOME=/opt/java/openjdk PATH=/opt/java/openjdk/bin:/opt/microsoft/powershell/7:$PATH CI=true FIREBASE_CLI_DISABLE_MOTD=true
RUN apt-get update && apt-get install -y --no-install-recommends libicu72 libgssapi-krb5-2 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && npm install --global firebase-tools@15.34.0 --ignore-scripts
COPY requirements/test.lock requirements/test.lock
RUN python -m pip install --no-cache-dir --require-hashes -r requirements/test.lock
COPY . .
RUN python -m pip install --no-deps --no-build-isolation .
RUN python deploy/run-rollout-checks.py --source-sha "$SOURCE_SHA" --output /out

FROM python:3.12.13-slim-bookworm AS runtime
ARG SOURCE_SHA
LABEL org.opencontainers.image.revision=$SOURCE_SHA
WORKDIR /app
COPY requirements/cloud-linux.lock /locks/runtime.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /locks/runtime.lock
COPY --from=verified /out/dist /wheels
RUN python -m pip install --no-cache-dir --no-deps /wheels/*.whl && python -m pip check && useradd --uid 10001 --create-home app
USER 10001
ENV PORT=8080 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
EXPOSE 8080
CMD ["python", "-m", "campuspulse_recovery.cloud"]
